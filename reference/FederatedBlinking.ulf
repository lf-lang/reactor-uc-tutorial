
import LedController from "./LedController.ulf"
import LSM6DS33 from "./LSM6DS33.ulf"

preamble {=
  #define ROTATION_TO_TIME 20.0f
  #define BASE_BLINKING_PERIOD 1500
  #define MIN_BLINKING_PERIOD 50

  #define MAX(a,b) ((a) > (b) ? (a) : (b))
=}

reactor SensorReactor {
  lsm6ds33 = new LSM6DS33();
  led = new LedController();
  
  output orientation: Vector;
  timer t(0sec, 500ms);

  reaction(t) -> led.toggle {=
    lf_set(led.toggle, 0);
  =}

  lsm6ds33.orientation -> orientation;
}

reactor BlinkingReactor {
  led = new LedController();

  logical action blink: int;
  state blinking_speed: interval_t;
  input orientation: Vector;

  reaction(startup) -> led.set_state, blink {=
    lf_set(led.set_state, true);
    self->blinking_speed = SEC(10);
    lf_schedule(blink, SEC(1), 0);
  =}

  reaction(orientation) {=
    float total_angle_x = lsm6ds33.orientation->value.x;
    printf("total angle x: %.6f\n", total_angle_x);
    uint32_t time_speed_up = MAX((ROTATION_TO_TIME * total_angle_x) + BASE_BLINKING_PERIOD, MIN_BLINKING_PERIOD);
    printf("time delay: %li\n", time_speed_up);
    self->blinking_speed = MSEC(time_speed_up);
  =}

  reaction (blink) -> led.toggle, blink {=
    lf_set(led.toggle, 0);
    lf_schedule(blink, self->blinking_speed, 0);
  =}
}

federated reactor {
  @interface_coap(name="if1", address="fe80::e46b:69f7:d00d:2a31")
  sensor = new SensorReactor()

  @interface_coap(name="if1", address="fe80::6481:c8fa:8443:8e02")
  blinking = new BlinkingReactor()

  @link(left="if1", right="if1")
  sensor.orientation -> blinking.orientation after 10ms;
}
