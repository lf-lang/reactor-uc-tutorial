target uC

preamble {=
struct Vector {
  float x;
  float y;
  float z;
};

typedef struct Vector Vector;

#include "periph/i2c.h"
#include "ztimer.h"

/* I2C Configuration */
#define I2C_BUS         I2C_DEV(0)      // Usually I2C_DEV(0) in RIOT

/* WHO_AM_I register expected values for different sensor variants */
#define WHO_AM_I_DS33    0x69    // LSM6DS33
#define WHO_AM_I_DS3     0x6A    // LSM6DS3 / LSM6DS3TR-C (used on newer Bluefruit Feather)
#define WHO_AM_I_DSOX    0x6C    // LSM6DSOX

#define I2C_FLAG_NONE   0

/* LSM6DS33 Register Map */
#define WHO_AM_I        0x0F
#define CTRL1_XL        0x10
#define CTRL2_G         0x11
#define CTRL3_C         0x12
#define OUTX_L_G        0x22            // Gyro starts here
#define OUTX_L_XL       0x28            // Accel starts here

#define GYRO_OUTX_L         0x22    // Starting register for Gyro data
#define GYRO_SENSITIVITY    8.75f   // mdps/LSB for +/- 245 dps range (per datasheet)
#define DT                  0.0048f // 1 / 208Hz ODR = 0.0048 seconds
#define CALIBRATION_SAMPLES 200
=}

reactor LSM6DS33 {
  //output acceleration: Vector
  output orientation: Vector
  timer t(50msec, 150msec);//48msec);

  state angle_x: float;
  state angle_y: float;
  state angle_z: float;

  state angle_x_biat: float;
  state angle_y_biat: float;
  state angle_z_biat: float;

  state counter: int;

  state sensor_addr: uint8_t;

  reaction(startup) {=
    printf("initializing sensor\n");
    uint8_t whoami;

    self->angle_x = 0.0f;
    self->angle_y = 0.0f;
    self->angle_z = 0.0f;

    // 1. Acquire the bus
    i2c_acquire(I2C_BUS);

    // 2. Verify connection (WHO_AM_I)
    /* I2C addresses: 0x6A (SA0 low) or 0x6B (SA0 high) - Bluefruit Feather uses 0x6A */
    uint8_t addrs[] = {0x6A, 0x6B};
    int found = 0;

    for (int i = 0; i < 2; i++) {
      if (i2c_read_reg(I2C_BUS, addrs[i], WHO_AM_I, &whoami, I2C_FLAG_NONE) >= 0) {
        if (whoami == WHO_AM_I_DS33 || whoami == WHO_AM_I_DS3 || whoami == WHO_AM_I_DSOX) {
          self->sensor_addr = addrs[i];
          printf("found sensor at address: 0x%02X (WHO_AM_I: 0x%02X)\n", self->sensor_addr, whoami);
          found = 1;
          break;
        }
      }
    }
    if (!found) {
        i2c_release(I2C_BUS);
        printf("failure: device not found\n");
        return; // Wrong device
    }

    // 3. Software Reset
    i2c_write_reg(I2C_BUS, self->sensor_addr, CTRL3_C, 0x01, I2C_FLAG_NONE);

    // Wait for reset to complete (sensor needs time after software reset)
    i2c_release(I2C_BUS);
    ztimer_sleep(ZTIMER_SEC, 1);
    i2c_acquire(I2C_BUS);

    // 4. Configure Accel (208 Hz, +/- 2g)
    i2c_write_reg(I2C_BUS, self->sensor_addr, CTRL1_XL, 0x40, I2C_FLAG_NONE);

    // 5. Configure Gyro (208 Hz, 245 dps)
    i2c_write_reg(I2C_BUS, self->sensor_addr, CTRL2_G, 0x50, I2C_FLAG_NONE);

    // 6. Enable Block Data Update and Auto-increment (IF_INC)
    i2c_write_reg(I2C_BUS, self->sensor_addr, CTRL3_C, 0x44, I2C_FLAG_NONE);

    i2c_release(I2C_BUS);

    printf("successful sensor initialization\n");
  =}

  reaction(t) -> orientation {=
    uint8_t buf[6];
    int16_t raw_x, raw_y, raw_z;
    
    i2c_acquire(I2C_BUS);
    if (i2c_read_regs(I2C_BUS, self->sensor_addr, GYRO_OUTX_L, buf, 6, I2C_FLAG_NONE) < 0) {
      i2c_release(I2C_BUS);
      printf("failed to read gyro data\n");
      return;
    }
    i2c_release(I2C_BUS);

    // Reconstruct 16-bit signed integers (Little Endian)
    raw_x = (int16_t)(buf[0] | (buf[1] << 8));
    raw_y = (int16_t)(buf[2] | (buf[3] << 8));
    raw_z = (int16_t)(buf[4] | (buf[5] << 8));

    // Convert raw to Degrees Per Second (dps)
    // (raw * 8.75) / 1000 converts millidegrees to degrees
    float gx = (((float)raw_x) * GYRO_SENSITIVITY) / 1000.0f;
    float gy = (((float)raw_y) * GYRO_SENSITIVITY) / 1000.0f;
    float gz = (((float)raw_z) * GYRO_SENSITIVITY) / 1000.0f;

    if (self->counter < CALIBRATION_SAMPLES) {
      self->angle_x_biat += gx;
      self->angle_y_biat += gy;
      self->angle_z_biat += gz;
      self->counter++;
      return;
    } else if (self->counter == CALIBRATION_SAMPLES) {
      self->angle_x_biat /= CALIBRATION_SAMPLES;
      self->angle_y_biat /= CALIBRATION_SAMPLES;
      self->angle_z_biat /= CALIBRATION_SAMPLES;
      self->counter++; // Increment to avoid re-calibration
      printf("calibration complete: %.6f, %.6f, %.6f\n", self->angle_x_biat, self->angle_y_biat, self->angle_z_biat);
      return;
    } else {
      // Subtract bias from raw gyro readings
      gx -= self->angle_x_biat;
      gy -= self->angle_y_biat;
      gz -= self->angle_z_biat;
    }

    // Numerical Integration: Angle = Angle + (Velocity * Time)
    self->angle_x += gx * DT;
    self->angle_y += gy * DT;
    self->angle_z += gz * DT;

    // printf("\rdiff: %.6f, %.6f, %.6f", gx * DT, gy * DT, gz * DT);
    // printf("\ttotal: %.6f, %.6f, %.6f", self->angle_x, self->angle_y, self->angle_z);

    struct Vector vec;
    vec.x = self->angle_x;
    vec.y = self->angle_y;
    vec.z = self->angle_z;
    lf_set(orientation, vec);
  =}
}


