
preamble {=
  #include "led.h"
=}

reactor LedController(num: int = 0) {
  input set_state: bool;
  input toggle: int;

  reaction (set_state) {=
    if (set_state->value) {
      if (self->num == 0) {
        LED0_ON;
      } else {
        LED1_ON;
      } 
    } else {
      if (self->num == 0) {
        LED0_OFF;
      } else {
        LED1_OFF;
      } 
    }
  =}

  reaction (toggle) {=
    if (self->num == 0) {
      LED0_TOGGLE;
    } else {
      LED1_TOGGLE;
    }
  =}
}
