
import LedController from "./LedController.ulf"

reactor Src(id: int = 0) {
  output out: int

  led = new LedController();

  timer t(10msec, 2sec);
  reaction(t) -> out, led.toggle {=
    printf("Hello from Src!\n");
    lf_set(out, self->id);
    lf_set(led.toggle, 42);
  =}
}

reactor Dst {
  input in: int
  state check: bool = false
  led = new LedController(num=1);

  reaction(startup) {=
    printf("Hello from Dst!\n");
  =}

  reaction(in) -> led.toggle {=
    printf("Received %d from Src\n", in->value);
    lf_set(led.toggle, 42);
  =}
}

federated reactor {
  // black
  @interface_coap(name="if1", address="fe80::e46b:69f7:d00d:2a31")
  r1 = new Src(id=42)
  
  // blue
  @interface_coap(name="if1", address="fe80::6481:c8fa:8443:8e02")
  r2 = new Dst()

  @link(left="if1", right="if1")
  r1.out -> r2.in after 1s;
}
