target uC;

reactor HighFrequencySource {
    output out: int;
    timer t(1msec);
    state counter: int = 0;
    
    reaction(t) {=
        lf_set(out, self->counter++);
    =}
}

reactor DataSink {
    input in: int;
    
    reaction(in) {=
        printf("Received data: %d\n", in->value);
    =}
}

/*
  Task: The high-frequency source (1ms timer) with a 500ms delayed connection will drop
  values if the buffer is too small. Experiment with different @buffer values to find
  the minimum buffer size that prevents dropped values.
*/
main reactor {
    source = new HighFrequencySource();
    sink = new DataSink();

    @buffer(1)
    source.out -> sink.in after 500msec;
}
