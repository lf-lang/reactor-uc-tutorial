target uC

import LedController from "./LedController.lf"

reactor Src {
  output out: int

  led = new LedController();

  timer t(10msec, 2sec);
  reaction(t) -> out, led.toggle {=
    printf("Hello from Src!\n");
    lf_set(out, 42);
    lf_set(led.toggle, 42);
  =}
}

reactor Dst {
  input in: int
  state check: bool = false
  led = new LedController(num=1);

  reaction(startup) {=
    printf("Hello from Dst!\n");
  =}

  reaction(in) -> led.toggle {=
    printf("Received %d from Src\n", in->value);
    lf_set(led.toggle, 42);
  =}
}

federated reactor {
  @interface_coap(name="if1", address="<TODO>")
  r1 = new Src()
  
  /*
    Task: Instantiate the Dst reactor as a federate and configure the IP address
  */

  @link(left="if1", right="if1")
  r1.out -> r2.in after 1s;
}
